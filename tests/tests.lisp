;;;; Tests: each case is (ELISP-SOURCE EXPECTED-PRINTED-RESULT), printed
;;;; the way Emacs's prin1 would. Run: (asdf:test-system "cclsh-elisp/tests").

(defpackage #:cclsh-elisp-tests (:use #:cl) (:export #:run))
(in-package #:cclsh-elisp-tests)

(defparameter *cases*
  '(("(+ 1 2 3)" "6")
    ("(/ 7 2)" "3")
    ("(/ 7 2.0)" "3.5")
    ("(let ((x 1)) (let ((f (lambda () x))) (setq x 5) (funcall f)))" "5")
    ("(defun make-counter () (let ((n 0)) (lambda () (setq n (1+ n)))))
      (let ((c (make-counter))) (funcall c) (funcall c) (funcall c))" "3")
    ("(defvar my-dyn 1) (defun read-dyn () my-dyn) (list (read-dyn) (let ((my-dyn 2)) (read-dyn)) (read-dyn))" "(1 2 1)")
    ("(defmacro my-unless (c &rest body) `(if ,c nil ,@body)) (my-unless nil 'ran)" "ran")
    ("(let ((x 2)) `(a ,x ,@(list 3 4) . ,(+ x 3)))" "(a 2 3 4 . 5)")
    ("(mapcar (lambda (x) (* x x)) '(1 2 3))" "(1 4 9)")
    ("(mapconcat #'upcase '(\"a\" \"b\") \"-\")" "\"A-B\"")
    ("(format \"%s has %d items, %.2f%% done, %S\" \"list\" 3 41.5 \"q\")" "\"list has 3 items, 41.50% done, \\\"q\\\"\"")
    ("(format \"%-5s|%5d|%03d\" \"ab\" 42 7)" "\"ab   |   42|007\"")
    ("(split-string \"a, b,,c\" \", *\" t)" "(\"a\" \"b\" \"c\")")
    ("(split-string \"  hello   world \")" "(\"hello\" \"world\")")
    ("(when (string-match \"\\\\([a-z]+\\\\)-\\\\([0-9]+\\\\)\" \"id: foo-42\") (list (match-string 1 \"id: foo-42\") (string-to-number (match-string 2 \"id: foo-42\"))))" "(\"foo\" 42)")
    ("(replace-regexp-in-string \"o+\" \"0\" \"foo boo\")" "\"f0 b0\"")
    ("(replace-regexp-in-string \"\\\\(b\\\\)\\\\(o\\\\)\" \"\\\\2\\\\1\" \"boo\")" "\"obo\"")
    ("(let ((h (make-hash-table :test 'equal))) (puthash \"k\" 1 h) (puthash \"j\" 2 h) (list (gethash \"k\" h) (gethash \"x\" h 'none) (hash-table-count h)))" "(1 none 2)")
    ("(condition-case err (car 5) (wrong-type-argument (list 'caught (car err))))" "(caught wrong-type-argument)")
    ("(condition-case err (error \"Bad %s\" \"thing\") (error (error-message-string err)))" "\"Bad thing\"")
    ("(catch 'done (dolist (x '(1 2 3 4)) (when (> x 2) (throw 'done x))))" "3")
    ("(let ((sum 0)) (dotimes (i 5) (setq sum (+ sum i))) sum)" "10")
    ("(let ((l nil)) (push 1 l) (push 2 l) (list (pop l) l))" "(2 (1))")
    ("(alist-get 'b '((a . 1) (b . 2)))" "2")
    ("(plist-get '(:x 1 :y 2) :y)" "2")
    ("(seq-filter #'cl-evenp '(1 2 3 4))" "(2 4)")
    ("(seq-filter (lambda (n) (= 0 (% n 2))) (number-sequence 1 10))" "(2 4 6 8 10)")
    ("(seq-reduce #'+ '(1 2 3) 10)" "16")
    ("(sort '(3 1 2) #'<)" "(1 2 3)")
    ("(when-let ((x (assoc \"b\" '((\"a\" . 1) (\"b\" . 2))))) (cdr x))" "2")
    ("(string-prefix-p \"foo\" \"foobar\")" "t")
    ("(substring \"hello\" -3)" "\"llo\"")
    ("(aref \"abc\" 1)" "98")
    ("?a" "97")
    ("(concat \"x\" (list ?y ?z))" "\"xyz\"")
    ("(let* ((a 1) (b (+ a 1))) (list a b))" "(1 2)")
    ("(insert \"hi\")" "(void-function insert)")
    ("(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))) (fib 20)" "6765")
    ("[1 2 (3)]" "[1 2 (3)]")
    ("(cond ((= 1 2) 'a) ((= 1 1) 'b))" "b")
    ("(list (length \"tab\\there\") (aref \"tab\\there\" 3))" "(8 9)")))

(defparameter *program-cases*
  '(("(csv-test)" "((\"a\" \"b\") (\"q,1\" \"say \\\"hi\\\"\"))")
    ("(rows-test)" "(((\"key\" . \"C-x\") (\"action\" . \"save\")) ((\"key\" . \"M-q\") (\"action\" . \"fill\")))")
    ("(chord-parse \"Ctrl+Shift+k\")" "((ctrl shift) . \"k\")")
    ("(chord-parse \"Hyper+k\")" "(user-error \"Unknown modifier \\\"Hyper\\\"\")")
    ("(cl-loop for x in '(1 2 3 4) for i from 0 when (cl-oddp x) collect (* x i))" "(0 6)")
    ("(cl-labels ((ev (n) (if (= n 0) t (od (1- n)))) (od (n) (if (= n 0) nil (ev (1- n))))) (ev 10))" "t"))
  "Cases run after tests/programs.el is loaded.")

(defun result-string (source)
  (string-right-trim '(#\Newline)
                     (with-output-to-string (*standard-output*)
                       (elisp::report (lambda () (elisp:eval-string source))))))

(defun run ()
  "Run every case; return T when all pass."
  (let ((pass 0) (fail 0))
    (elisp:load-file (asdf:system-relative-pathname "cclsh-elisp/tests" "tests/programs.el"))
    (dolist (c (append *cases* *program-cases*))
      (let ((got (result-string (first c))))
        (if (string= got (second c))
            (incf pass)
            (progn (incf fail)
                   (format t "FAIL ~a~%  want ~a~%  got  ~a~%" (first c) (second c) got)))))
    (format t "PASS ~d FAIL ~d~%" pass fail)
    (zerop fail)))
