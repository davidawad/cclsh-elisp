;;;; elisp.lisp -- an Emacs Lisp interpreter in Common Lisp (no Emacs involved).
;;;;
;;;; Runs the editor-independent part of Elisp natively: lexical closures,
;;;; defvar specials (dynamic let), macros and backquote, catch / throw,
;;;; condition-case, cl-loop / cl-flet / cl-labels, lists, strings, format,
;;;; regexps (translated to cl-ppcre), hash tables, vectors and the common
;;;; seq- / subr-x helpers. Buffers, windows, markers, text properties and
;;;; keymaps are Emacs's C core and are not here: calling one signals
;;;; (void-function NAME).
;;;;
;;;; API (package ELISP): eval-string, load-file, repl, prin1-string.

(defpackage #:elisp-sym (:use))
(defpackage #:elisp (:use #:cl)
  (:export #:eval-string #:load-file #:repl #:prin1-string #:princ-string
           #:*define-function-hook* #:report))
(in-package #:elisp)

;;; -- Reader --

(defun esym (name) (intern name '#:elisp-sym))
(defparameter +backquote+ (esym "`"))
(defparameter +comma+ (esym ","))
(defparameter +comma-at+ (esym ",@"))

(defun read-escape (stream)
  "The character after a backslash in a string or ?-literal."
  (let ((c (read-char stream)))
    (case c
      (#\n #\Newline) (#\t #\Tab) (#\r #\Return) (#\e (code-char 27))
      (#\s #\Space) (#\a (code-char 7)) (#\f #\Page) (#\0 (code-char 0))
      (#\Newline nil)
      (t c))))

(defun read-elisp-string (stream char)
  (declare (ignore char))
  (with-output-to-string (out)
    (loop for c = (read-char stream)
          until (char= c #\")
          do (if (char= c #\\)
                 (let ((e (read-escape stream))) (when e (write-char e out)))
                 (write-char c out)))))

(defun read-char-literal (stream char)
  (declare (ignore char))
  (let ((c (read-char stream)))
    (char-code (if (char= c #\\) (or (read-escape stream) #\Newline) c))))

(defparameter *readtable-elisp*
  (let ((rt (copy-readtable nil)))
    (setf (readtable-case rt) :preserve)
    (set-macro-character #\" #'read-elisp-string nil rt)
    (set-macro-character #\? #'read-char-literal t rt)
    (set-macro-character #\[ (lambda (s c) (declare (ignore c))
                               (coerce (read-delimited-list #\] s t) 'vector))
                         nil rt)
    (set-macro-character #\] (get-macro-character #\) rt) nil rt)
    (set-macro-character #\` (lambda (s c) (declare (ignore c))
                               (list +backquote+ (read s t nil t)))
                         nil rt)
    (set-macro-character #\, (lambda (s c) (declare (ignore c))
                               (if (eql (peek-char nil s) #\@)
                                   (progn (read-char s) (list +comma-at+ (read s t nil t)))
                                   (list +comma+ (read s t nil t))))
                         nil rt)
    rt))

(defun normalize (form)
  "Elisp nil and t are CL NIL and T."
  (cond ((consp form) (cons (normalize (car form)) (normalize (cdr form))))
        ((and (symbolp form) (eq (symbol-package form) (find-package '#:elisp-sym)))
         (cond ((string= (symbol-name form) "nil") nil)
               ((string= (symbol-name form) "t") t)
               (t form)))
        ((and (vectorp form) (not (stringp form))) (map 'vector #'normalize form))
        (t form)))

(defun read-forms (string)
  (let ((*readtable* *readtable-elisp*)
        (*package* (find-package '#:elisp-sym))
        (*read-default-float-format* 'double-float)
        (*read-eval* nil))
    (with-input-from-string (in string)
      (loop for form = (read in nil in)
            until (eq form in)
            collect (normalize form)))))

;;; -- State --

(defvar *globals* (make-hash-table :test #'eq))
(defvar *functions* (make-hash-table :test #'eq))
(defvar *macros* (make-hash-table :test #'eq))
(defvar *specials* (make-hash-table :test #'eq))
(defvar *special-forms* (make-hash-table :test #'equal))

(define-condition elisp-error (error)
  ((symbol :initarg :symbol :reader error-symbol)
   (data :initarg :data :reader error-data))
  (:report (lambda (c s) (format s "~a" (prin1-string (cons (error-symbol c) (error-data c)))))))

(defun signal-elisp (name &rest data)
  (error 'elisp-error :symbol (if (symbolp name) name (esym name)) :data data))

;;; -- Evaluator --

(defun lookup-variable (symbol env)
  (let ((cell (assoc symbol env)))
    (cond (cell (cdr cell))
          (t (multiple-value-bind (value present) (gethash symbol *globals*)
               (if present value (signal-elisp "void-variable" symbol)))))))

(defun set-variable (symbol value env)
  (let ((cell (assoc symbol env)))
    (if cell
        (setf (cdr cell) value)
        (setf (gethash symbol *globals*) value))))

(defun callable (designator)
  "A CL function for an Elisp function designator."
  (cond ((functionp designator) designator)
        ((null designator) (signal-elisp "void-function" nil))
        ((symbolp designator)
         (or (gethash designator *functions*)
             (signal-elisp "void-function" designator)))
        ((and (consp designator) (symbolp (car designator))
              (string= (symbol-name (car designator)) "lambda"))
         (make-closure (cadr designator) (cddr designator) nil))
        (t (signal-elisp "invalid-function" designator))))

(defun ecall (f &rest args) (apply (callable f) args))

(defun eval-body (body env)
  (let ((value nil))
    (dolist (form body value)
      (setf value (eval-form form env)))))

(defun strip-doc (body)
  "BODY without its docstring, (declare ...) and (interactive ...) forms."
  (when (and (stringp (first body)) (rest body)) (pop body))
  (loop while (and (consp (first body)) (symbolp (car (first body)))
                   (member (symbol-name (car (first body))) '("declare" "interactive")
                           :test #'string=))
        do (pop body))
  body)

(defun bind-parameters (params args env)
  "ENV extended with PARAMS bound to ARGS (&optional, &rest)."
  (let ((mode :required) (specials '()))
    (dolist (p params)
      (let ((name (symbol-name p)))
        (cond ((string= name "&optional") (setf mode :optional))
              ((string= name "&rest") (setf mode :rest))
              (t (let ((value (ecase mode
                                (:required (if args (pop args)
                                               (signal-elisp "wrong-number-of-arguments" params)))
                                (:optional (pop args))
                                (:rest (prog1 args (setf args nil))))))
                   (if (gethash p *specials*)
                       (push (cons p value) specials)
                       (push (cons p value) env)))))))
    (when args (signal-elisp "wrong-number-of-arguments" params (length args)))
    (values env specials)))

(defun call-with-specials (bindings thunk)
  "Dynamically bind special BINDINGS ((symbol . value)...) around THUNK."
  (if (null bindings)
      (funcall thunk)
      (let ((saved (loop for (s) in bindings
                         collect (multiple-value-list (gethash s *globals*)))))
        (unwind-protect
             (progn (loop for (s . v) in bindings do (setf (gethash s *globals*) v))
                    (funcall thunk))
          (loop for (s) in bindings
                for (value present) in saved
                do (if present (setf (gethash s *globals*) value) (remhash s *globals*)))))))

(defun make-closure (params body env)
  (let ((body (strip-doc body)))
    (lambda (&rest args)
      (multiple-value-bind (new-env specials) (bind-parameters params args env)
        (call-with-specials specials (lambda () (eval-body body new-env)))))))

(defun backquote (form env)
  (cond ((and (vectorp form) (not (stringp form)))
         (coerce (backquote (coerce form 'list) env) 'vector))
        ((atom form) form)
        ((eq (car form) +comma+) (eval-form (cadr form) env))
        ((and (consp (car form)) (eq (caar form) +comma-at+))
         (append (eval-form (cadar form) env) (backquote (cdr form) env)))
        (t (cons (backquote (car form) env) (backquote (cdr form) env)))))

(defpackage #:elisp-fn (:use))
(defun fn-key (symbol)
  "ENV key of a cl-flet/cl-labels local function named SYMBOL."
  (intern (symbol-name symbol) '#:elisp-fn))

(defun eval-form (form env)
  (cond ((null form) nil)
        ((eq form t) t)
        ((keywordp form) form)
        ((symbolp form) (lookup-variable form env))
        ((atom form) form)
        (t (let ((head (car form)))
             (cond ((eq head 'quote) (cadr form))
                   ((or (eq head 'function)
                        (and (symbolp head) (string= (symbol-name head) "function")
                             (eq (symbol-package head) (find-package '#:elisp-sym))))
                    (let ((f (cadr form)))
                      (cond ((and (consp f) (string= (symbol-name (car f)) "lambda"))
                             (make-closure (cadr f) (cddr f) env))
                            ((and (symbolp f) f (assoc (fn-key f) env))
                             (cdr (assoc (fn-key f) env)))
                            (t f))))
                   ((eq head +backquote+) (backquote (cadr form) env))
                   ((not (symbolp head))
                    (apply (if (and (consp head) (string= (symbol-name (car head)) "lambda"))
                               (make-closure (cadr head) (cddr head) env)
                               (signal-elisp "invalid-function" head))
                           (mapcar (lambda (a) (eval-form a env)) (cdr form))))
                   (t (let ((special (gethash (symbol-name head) *special-forms*)))
                        (cond (special (funcall special (cdr form) env))
                              ((gethash head *macros*)
                               (eval-form (apply (gethash head *macros*) (cdr form)) env))
                              (t (apply (let ((local (assoc (fn-key head) env)))
                                          (if local (cdr local) (callable head)))
                                        (mapcar (lambda (a) (eval-form a env)) (cdr form))))))))))))

(defmacro defspecial (name (args env) &body body)
  `(setf (gethash ,name *special-forms*) (lambda (,args ,env) (declare (ignorable ,env)) ,@body)))

;;; -- Special forms --

(defspecial "quote" (a e) (car a))
(defspecial "progn" (a e) (eval-body a e))
(defspecial "prog1" (a e) (prog1 (eval-form (car a) e) (eval-body (cdr a) e)))
(defspecial "prog2" (a e) (eval-form (car a) e) (prog1 (eval-form (cadr a) e) (eval-body (cddr a) e)))
(defspecial "if" (a e) (if (eval-form (first a) e) (eval-form (second a) e) (eval-body (cddr a) e)))
(defspecial "when" (a e) (when (eval-form (car a) e) (eval-body (cdr a) e)))
(defspecial "unless" (a e) (unless (eval-form (car a) e) (eval-body (cdr a) e)))
(defspecial "and" (a e) (let ((v t)) (dolist (f a v) (unless (setf v (eval-form f e)) (return nil)))))
(defspecial "or" (a e) (dolist (f a nil) (let ((v (eval-form f e))) (when v (return v)))))
(defspecial "not" (a e) (not (eval-form (car a) e)))
(defspecial "cond" (a e)
  (dolist (clause a nil)
    (let ((v (eval-form (car clause) e)))
      (when v (return (if (cdr clause) (eval-body (cdr clause) e) v))))))
(defspecial "while" (a e) (loop while (eval-form (car a) e) do (eval-body (cdr a) e)) nil)
(defspecial "lambda" (a e) (make-closure (car a) (cdr a) e))

(defun let-bindings (bindings e sequential)
  "Returns (values env specials) for a let / let* binding list."
  (let ((new-env e) (specials '()))
    (dolist (b bindings)
      (let* ((name (if (consp b) (car b) b))
             (value (if (consp b) (eval-form (cadr b) (if sequential new-env e)) nil)))
        (if (gethash name *specials*)
            (progn (push (cons name value) specials)
                   (when sequential (setf (gethash name *globals*) value)))
            (push (cons name value) new-env))))
    (values new-env (nreverse specials))))

(defun eval-let (a e sequential)
  (if sequential
      ;; let*: each init sees the specials bound so far.
      (let ((saved '()))
        (multiple-value-bind (env specials)
            (let ((new-env e) (specials '()))
              (dolist (b (car a) (values new-env specials))
                (let* ((name (if (consp b) (car b) b))
                       (value (if (consp b) (eval-form (cadr b) new-env) nil)))
                  (if (gethash name *specials*)
                      (progn (push (cons name (multiple-value-list (gethash name *globals*))) saved)
                             (setf (gethash name *globals*) value)
                             (push name specials))
                      (push (cons name value) new-env)))))
          (declare (ignore specials))
          (unwind-protect (eval-body (cdr a) env)
            (loop for (name value present) in saved
                  do (if present (setf (gethash name *globals*) value) (remhash name *globals*))))))
      (multiple-value-bind (env specials) (let-bindings (car a) e nil)
        (call-with-specials specials (lambda () (eval-body (cdr a) env))))))

(defspecial "let" (a e) (eval-let a e nil))
(defspecial "let*" (a e) (eval-let a e t))

(defspecial "setq" (a e)
  (loop for (s v) on a by #'cddr
        for value = (eval-form v e)
        do (set-variable s value e)
        finally (return value)))

(defun place-set (place value e)
  (if (symbolp place)
      (set-variable place value e)
      (let ((op (symbol-name (car place)))
            (args (mapcar (lambda (x) (eval-form x e)) (cdr place))))
        (cond ((string= op "car") (setf (car (first args)) value))
              ((string= op "cdr") (setf (cdr (first args)) value))
              ((string= op "nth") (setf (nth (first args) (second args)) value))
              ((string= op "gethash") (setf (gethash (hkey (first args)) (second args)) value))
              ((string= op "aref") (setf (aref (first args) (second args))
                                         (if (stringp (first args)) (code-char value) value)))
              (t (signal-elisp "error" (format nil "setf of ~a unsupported" op))))
        value)))

(defspecial "setf" (a e)
  (loop for (p v) on a by #'cddr
        for value = (eval-form v e)
        do (place-set p value e)
        finally (return value)))
(defspecial "push" (a e) (place-set (cadr a) (cons (eval-form (car a) e) (eval-form (cadr a) e)) e))
(defspecial "pop" (a e)
  (let ((list (eval-form (car a) e)))
    (place-set (car a) (cdr list) e)
    (car list)))
(dolist (n '("cl-incf" "incf" "cl-decf" "decf"))
  (let ((sign (if (search "decf" n) -1 1)))
    (setf (gethash n *special-forms*)
          (lambda (a e)
            (place-set (car a) (+ (eval-form (car a) e)
                                  (* sign (if (cdr a) (eval-form (cadr a) e) 1)))
                       e)))))

(defvar *define-function-hook* '()
  "Functions called with (SYMBOL FUNCTION) whenever Elisp defines a function
(defun, defalias, fset). A host uses it to expose Elisp functions as its own.")

(defun define-function (symbol function)
  (setf (gethash symbol *functions*) function)
  (dolist (hook *define-function-hook*) (funcall hook symbol function))
  symbol)

(defspecial "defun" (a e)
  (define-function (car a) (make-closure (cadr a) (cddr a) nil)))
(defspecial "defmacro" (a e)
  (setf (gethash (car a) *macros*) (make-closure (cadr a) (cddr a) nil))
  (car a))
(defspecial "defalias" (a e)
  (let ((name (eval-form (car a) e)) (def (eval-form (cadr a) e)))
    (define-function name (callable def))))
(flet ((defvar-like (always)
         (lambda (a e)
           (setf (gethash (car a) *specials*) t)
           (when (and (cdr a) (or always (not (nth-value 1 (gethash (car a) *globals*)))))
             (setf (gethash (car a) *globals*) (eval-form (cadr a) e)))
           (car a))))
  (setf (gethash "defvar" *special-forms*) (defvar-like nil)
        (gethash "defcustom" *special-forms*) (defvar-like nil)
        (gethash "defvar-local" *special-forms*) (defvar-like nil)
        (gethash "defconst" *special-forms*) (defvar-like t)))
(defspecial "setq-default" (a e) (funcall (gethash "setq" *special-forms*) a nil))
(defspecial "setq-local" (a e) (funcall (gethash "setq" *special-forms*) a e))

(defspecial "dolist" (a e)
  (destructuring-bind (var list-form &optional result) (car a)
    (let ((cell (cons var nil)))
      (dolist (x (eval-form list-form e))
        (setf (cdr cell) x)
        (eval-body (cdr a) (cons cell e)))
      (when result (setf (cdr cell) nil) (eval-form result (cons cell e))))))
(defspecial "dotimes" (a e)
  (destructuring-bind (var count-form &optional result) (car a)
    (let ((cell (cons var nil)) (n (eval-form count-form e)))
      (dotimes (i n)
        (setf (cdr cell) i)
        (eval-body (cdr a) (cons cell e)))
      (when result (setf (cdr cell) n) (eval-form result (cons cell e))))))

(defspecial "catch" (a e) (catch (eval-form (car a) e) (eval-body (cdr a) e)))
(defspecial "unwind-protect" (a e)
  (unwind-protect (eval-form (car a) e) (eval-body (cdr a) e)))

(defun cl-error-symbol (c)
  (typecase c
    (elisp-error (error-symbol c))
    (division-by-zero (esym "arith-error"))
    (type-error (esym "wrong-type-argument"))
    (t (esym "error"))))

(defun cl-error-data (c)
  (if (typep c 'elisp-error) (error-data c) (list (princ-to-string c))))

(defun error-matches-p (spec symbol)
  (let ((names (if (listp spec) spec (list spec))))
    (some (lambda (n) (or (string= (symbol-name n) "error")
                          (string= (symbol-name n) "t")
                          (eq n symbol)))
          (remove nil names))))

(defspecial "condition-case" (a e)
  (destructuring-bind (var body-form &rest handlers) a
    (handler-case (eval-form body-form e)
      (error (c)
        (let* ((symbol (cl-error-symbol c))
               (handler (find-if (lambda (h) (or (eq (car h) t) (error-matches-p (car h) symbol)))
                                 handlers)))
          (unless handler (error c))
          (eval-body (cdr handler)
                     (if var (acons var (cons symbol (cl-error-data c)) e) e)))))))
(defspecial "ignore-errors" (a e) (handler-case (eval-body a e) (error () nil)))

(defun if-let-bindings (bindings e)
  "ENV with BINDINGS bound in order, or :fail at the first nil value."
  (dolist (b (if (and (consp bindings) (symbolp (car bindings)) (car bindings))
                 (list bindings) bindings)
             e)
    (let* ((name (if (and (consp b) (cdr b)) (car b) nil))
           (value (eval-form (if (consp b) (car (last b)) b) e)))
      (unless value (return :fail))
      (when name (setf e (acons name value e))))))
(dolist (n '("if-let" "if-let*"))
  (setf (gethash n *special-forms*)
        (lambda (a e)
          (let ((env (if-let-bindings (car a) e)))
            (if (eq env :fail) (eval-body (cddr a) e) (eval-form (cadr a) env))))))
(dolist (n '("when-let" "when-let*" "and-let*"))
  (setf (gethash n *special-forms*)
        (lambda (a e)
          (let ((env (if-let-bindings (car a) e)))
            (unless (eq env :fail) (if (cdr a) (eval-body (cdr a) env) t))))))

(defspecial "cl-flet" (a e)
  (let ((new-env e))
    (dolist (b (car a))
      ;; (name (args) body...) or (name expr)
      (push (cons (fn-key (car b))
                  (if (and (cddr b) (listp (cadr b)))
                      (make-closure (cadr b) (cddr b) e)
                      (callable (eval-form (cadr b) e))))
            new-env))
    (eval-body (cdr a) new-env)))
(defspecial "cl-labels" (a e)
  (let* ((cells (mapcar (lambda (b) (cons (fn-key (car b)) nil)) (car a)))
         (new-env (append cells e)))
    (loop for b in (car a) for cell in cells
          do (setf (cdr cell) (make-closure (cadr b) (cddr b) new-env)))
    (eval-body (cdr a) new-env)))

;;; cl-loop, the common subset: for VAR in/on/across/from..to|below|downto..by/
;;; = .. then, repeat, with, while, until, when/if/unless, do, collect, append,
;;; nconc, concat, sum, count, maximize, minimize (into VAR), return,
;;; finally [return] FORM.

(defun kw (x name) (and (symbolp x) x (string= (symbol-name x) name)))
(defun kw-in (x &rest names) (and (symbolp x) x (member (symbol-name x) names :test #'string=)))

(defspecial "cl-loop" (a e)
  (let ((clauses a) (env e) (steps '()) (tests '()) (body '()) (finally nil)
        (finally-return nil) (result-cell (cons (esym " loop-result") nil)) (result-kind nil))
    (setf env (cons result-cell env))
    (labels ((cell (var) (or (assoc var env) (let ((c (cons var nil))) (push c env) c)))
             (parse-action ()
               ;; returns a thunk for one accumulate / do clause
               (let ((op (pop clauses)))
                 (cond
                   ((kw op "do")
                    (let ((forms (loop while (consp (first clauses)) collect (pop clauses))))
                      (lambda () (eval-body forms env))))
                   ((kw op "return")
                    (let ((form (pop clauses)))
                      (lambda () (throw 'cl-loop-return (eval-form form env)))))
                   ((kw-in op "collect" "collecting" "append" "appending" "nconc" "nconcing"
                           "concat" "sum" "summing" "count" "counting" "maximize" "minimize")
                    (let* ((form (pop clauses))
                           (into (when (kw (first clauses) "into") (pop clauses) (pop clauses)))
                           (target (if into (cell into) result-cell))
                           (name (symbol-name op)))
                      (unless into
                        (setf result-kind (if (search "collect" name) :collect
                                              (if (or (search "append" name) (search "nconc" name))
                                                  :append :scalar))))
                      (when (or (search "sum" name) (search "count" name))
                        (unless (numberp (cdr target)) (setf (cdr target) 0)))
                      (when (string= name "concat") (setf (cdr target) ""))
                      (lambda ()
                        (let ((v (eval-form form env)))
                          (setf (cdr target)
                                (cond ((search "collect" name) (append (cdr target) (list v)))
                                      ((or (search "append" name) (search "nconc" name))
                                       (append (cdr target) (copy-list v)))
                                      ((string= name "concat") (concatenate 'string (cdr target) v))
                                      ((search "sum" name) (+ (cdr target) v))
                                      ((search "count" name) (if v (1+ (cdr target)) (cdr target)))
                                      ((string= name "maximize") (if (cdr target) (max (cdr target) v) v))
                                      (t (if (cdr target) (min (cdr target) v) v))))))))
                   ((kw-in op "when" "if" "unless")
                    (let* ((test (pop clauses)) (then (parse-action))
                           (negate (kw op "unless")))
                      (loop while (kw (first clauses) "and")
                            do (pop clauses)
                               (let ((prev then) (next (parse-action)))
                                 (setf then (lambda () (funcall prev) (funcall next)))))
                      (let ((else (when (kw (first clauses) "else") (pop clauses) (parse-action))))
                        (lambda ()
                          (if (if negate (not (eval-form test env)) (eval-form test env))
                              (funcall then)
                              (when else (funcall else)))))))
                   (t (signal-elisp "error" (format nil "cl-loop: unsupported clause ~a" (prin1-string op))))))))
      (loop while clauses
            do (let ((c (first clauses)))
                 (cond
                   ((kw-in c "for" "as")
                    (pop clauses)
                    (let* ((var (pop clauses)) (how (pop clauses)) (vc (cell var)))
                      (cond
                        ((kw how "in")
                         (let ((rest (cons nil (eval-form (pop clauses) env))))
                           (push (lambda () (and (cdr rest) (progn (setf (cdr vc) (pop (cdr rest))) t))) tests)))
                        ((kw how "on")
                         (let ((rest (cons nil (eval-form (pop clauses) env))))
                           (push (lambda () (and (cdr rest) (progn (setf (cdr vc) (cdr rest)) (pop (cdr rest)) t))) tests)))
                        ((kw how "across")
                         (let ((seq (elements (eval-form (pop clauses) env))))
                           (push (lambda () (and seq (progn (setf (cdr vc) (pop seq)) t))) tests)))
                        ((kw how "=")
                         (let ((init (pop clauses))
                               (then (when (kw (first clauses) "then") (pop clauses) (pop clauses)))
                               (first-p t))
                           (push (lambda ()
                                   (setf (cdr vc) (eval-form (if (or first-p (null then)) init then) env)
                                         first-p nil)
                                   t)
                                 tests)))
                        ((kw-in how "from" "upfrom" "downfrom")
                         (let ((start (eval-form (pop clauses) env)) (limit nil) (limit-kind nil) (by 1)
                               (down (kw how "downfrom")))
                           (loop while (kw-in (first clauses) "to" "upto" "below" "downto" "above" "by")
                                 do (let ((k (symbol-name (pop clauses))) (v (eval-form (pop clauses) env)))
                                      (if (string= k "by") (setf by v)
                                          (setf limit v limit-kind k
                                                down (or down (member k '("downto" "above") :test #'string=))))))
                           (let ((i start) (first-p t))
                             (push (lambda ()
                                     (unless first-p (setf i (if down (- i by) (+ i by))))
                                     (setf first-p nil (cdr vc) i)
                                     (or (null limit)
                                         (cond ((string= limit-kind "below") (< i limit))
                                               ((string= limit-kind "above") (> i limit))
                                               (down (>= i limit))
                                               (t (<= i limit)))))
                                   tests))))
                        (t (signal-elisp "error" (format nil "cl-loop: unsupported for ~a" (prin1-string how)))))))
                   ((kw c "repeat")
                    (pop clauses)
                    (let ((n (eval-form (pop clauses) env)))
                      (push (lambda () (>= (decf n) 0)) tests)))
                   ((kw c "with")
                    (pop clauses)
                    (let ((var (pop clauses)))
                      (setf (cdr (cell var))
                            (when (kw (first clauses) "=") (pop clauses) (eval-form (pop clauses) env)))))
                   ((kw-in c "while" "until")
                    (pop clauses)
                    (let ((form (pop clauses)) (until (kw c "until")))
                      (push (lambda () (let ((v (eval-form form env))) (if until (not v) v))) body)
                      (push :test body)))
                   ((kw c "finally")
                    (pop clauses)
                    (if (kw (first clauses) "return")
                        (progn (pop clauses) (setf finally-return (pop clauses)))
                        (setf finally (pop clauses))))
                   (t (push (parse-action) body)))))
      (setf tests (nreverse tests) body (nreverse body))
      (catch 'cl-loop-return
        (loop
          (unless (every #'funcall tests) (return))
          (let ((stop nil))
            (loop for rest on body
                  do (cond ((eq (car rest) :test))
                           ((and (cdr rest) (eq (cadr rest) :test))
                            (unless (funcall (car rest)) (setf stop t) (return)))
                           (t (funcall (car rest)))))
            (when stop (return))))
        (when finally (eval-form finally env))
        (if finally-return
            (eval-form finally-return env)
            (cdr result-cell))))))

;;; -- Printer --

(defun prin1-string (x)
  (let ((*read-default-float-format* 'double-float))
    (with-output-to-string (out) (print-elisp x out t))))

(defun princ-string (x)
  (cond ((stringp x) x)
        ((and (symbolp x) x (not (eq x t))) (symbol-name x))
        (t (let ((*read-default-float-format* 'double-float))
             (with-output-to-string (out) (print-elisp x out nil))))))

(defun print-elisp (x out escape)
  (cond ((null x) (write-string "nil" out))
        ((eq x t) (write-string "t" out))
        ((keywordp x) (format out ":~a" (symbol-name x)))
        ((symbolp x) (write-string (symbol-name x) out))
        ((stringp x)
         (if escape
             (progn (write-char #\" out)
                    (loop for c across x
                          do (when (member c '(#\" #\\)) (write-char #\\ out))
                             (write-char c out))
                    (write-char #\" out))
             (write-string x out)))
        ((floatp x) (let ((s (format nil "~f" x)))
                      (write-string (if (char= (char s (1- (length s))) #\.)
                                        (concatenate 'string s "0") s)
                                    out)))
        ((vectorp x) (write-char #\[ out)
                     (loop for i from 0 for y across x
                           do (when (plusp i) (write-char #\Space out)) (print-elisp y out escape))
                     (write-char #\] out))
        ((consp x)
         (if (and (eq (car x) 'quote) (consp (cdr x)) (null (cddr x)))
             (progn (write-char #\' out) (print-elisp (cadr x) out escape))
             (progn
               (write-char #\( out)
               (loop for rest = x then (cdr rest)
                     for first = t then nil
                     while (consp rest)
                     do (unless first (write-char #\Space out))
                        (print-elisp (car rest) out escape)
                     finally (when rest (write-string " . " out) (print-elisp rest out escape)))
               (write-char #\) out))))
        ((hash-table-p x) (format out "#s(hash-table size ~d)" (hash-table-count x)))
        ((functionp x) (write-string "#<lambda>" out))
        (t (format out "~a" x))))

;;; -- format --

(defun elisp-format (control &rest args)
  (with-output-to-string (out)
    (let ((i 0) (n (length control)))
      (loop while (< i n)
            do (let ((c (char control i)))
                 (if (or (char/= c #\%) (>= (1+ i) n))
                     (progn (write-char c out) (incf i))
                     (let* ((j (1+ i))
                            (flags (loop while (and (< j n) (find (char control j) "-0+ #"))
                                         collect (char control j) do (incf j)))
                            (width (loop with w = nil
                                         while (and (< j n) (digit-char-p (char control j)))
                                         do (setf w (+ (* 10 (or w 0)) (digit-char-p (char control j))))
                                            (incf j)
                                         finally (return w)))
                            (precision (when (and (< j n) (char= (char control j) #\.))
                                         (incf j)
                                         (loop with p = 0
                                               while (and (< j n) (digit-char-p (char control j)))
                                               do (setf p (+ (* 10 p) (digit-char-p (char control j))))
                                                  (incf j)
                                               finally (return p))))
                            (conv (char control j))
                            (text
                              (if (char= conv #\%) "%"
                                  (let ((arg (pop args)))
                                    (case conv
                                      (#\s (let ((s (princ-string arg)))
                                             (if precision (subseq s 0 (min precision (length s))) s)))
                                      (#\S (prin1-string arg))
                                      (#\d (format nil "~d" (truncate arg)))
                                      (#\c (string (code-char arg)))
                                      (#\x (format nil "~(~x~)" arg))
                                      (#\X (format nil "~:@(~x~)" arg))
                                      (#\o (format nil "~o" arg))
                                      ((#\f #\e #\g)
                                       (format nil "~,vf" (or precision 6) (coerce arg 'double-float)))
                                      (t (signal-elisp "error" "Invalid format operation")))))))
                       (let ((pad (if width (max 0 (- width (length text))) 0)))
                         (cond ((member #\- flags) (write-string text out)
                                (dotimes (k pad) (write-char #\Space out)))
                               ((and (member #\0 flags) (find conv "dxXof"))
                                (dotimes (k pad) (write-char #\0 out)) (write-string text out))
                               (t (dotimes (k pad) (write-char #\Space out)) (write-string text out))))
                       (setf i (1+ j)))))))))

;;; -- Regexps (Elisp syntax -> cl-ppcre) --

(defun translate-regexp (re)
  (with-output-to-string (out)
    (let ((i 0) (n (length re)) (in-bracket nil))
      (loop while (< i n)
            do (let ((c (char re i)))
                 (cond
                   (in-bracket
                    (when (and (char= c #\]) (> i in-bracket)) (setf in-bracket nil))
                    (when (char= c #\\) (write-char #\\ out))
                    (write-char c out) (incf i))
                   ((char= c #\[)
                    (write-char c out) (incf i)
                    (when (and (< i n) (char= (char re i) #\^)) (write-char #\^ out) (incf i))
                    ;; a leading ] is literal
                    (setf in-bracket i)
                    (when (and (< i n) (char= (char re i) #\]))
                      (write-string "\\]" out) (incf i) (setf in-bracket i)))
                   ((find c "(){}|") (write-char #\\ out) (write-char c out) (incf i))
                   ((and (char= c #\\) (< (1+ i) n))
                    (let ((d (char re (1+ i))))
                      (write-string
                       (case d
                         ((#\( ) (if (and (< (+ i 3) n) (char= (char re (+ i 2)) #\?)
                                          (char= (char re (+ i 3)) #\:))
                                     (progn (incf i 2) "(?:")
                                     "("))
                         (#\) ")") (#\| "|") (#\{ "{") (#\} "}")
                         (#\` "\\A") (#\' "\\z")
                         (#\_ (incf i) "\\b")
                         (#\s (incf i) (if (char= (char re (1+ i)) #\-) "\\s" "\\s"))
                         (#\S (incf i) "\\S")
                         (t (format nil "\\~a" d)))
                       out)
                      (incf i 2)))
                   (t (write-char c out) (incf i))))))))

(defvar *match-data* nil "(string starts ends) of the last string-match.")

(defun string-match (regexp string &optional (start 0))
  (multiple-value-bind (ms me rs re)
      (cl-ppcre:scan (translate-regexp regexp) string :start (or start 0))
    (when ms
      (setf *match-data* (list string (cons ms rs) (cons me re)))
      ms)))

(defun match-bound (n which)
  (destructuring-bind (string starts ends) *match-data*
    (declare (ignore string))
    (let ((v (if (zerop n) (car (if (eq which :start) starts ends))
                 (aref (cdr (if (eq which :start) starts ends)) (1- n)))))
      v)))

(defun match-string (n &optional string)
  (let ((s (match-bound n :start)) (e (match-bound n :end)))
    (when s (subseq (or string (first *match-data*)) s e))))

;;; -- Primitives --

(defmacro defprim (name lambda-list &body body)
  `(setf (gethash (esym ,name) *functions*) (lambda ,lambda-list ,@body)))

(defun hkey (h) h)
(defun truthy-list (x) (if (vectorp x) (coerce x 'list) x))
(defun seq-result (template list)
  (cond ((stringp template) (coerce (mapcar #'code-char list) 'string))
        ((vectorp template) (coerce list 'vector))
        (t list)))
(defun elements (seq)
  "SEQ as a list, strings as character codes (Elisp chars are integers)."
  (cond ((stringp seq) (map 'list #'char-code seq))
        ((vectorp seq) (coerce seq 'list))
        (t seq)))

;; Direct CL equivalents.
(dolist (name '("car" "cdr" "cons" "list" "append" "nth" "nthcdr" "last" "butlast"
                "nreverse" "1+" "1-" "max" "min" "abs" "mod" "expt" "sqrt" "floor" "ceiling"
                "round" "truncate" "eq" "eql" "equal" "null" "consp" "listp" "atom" "numberp"
                "integerp" "floatp" "stringp" "symbolp" "functionp" "identity" "zerop"
                "logand" "logior" "logxor" "ash" "evenp" "oddp" "vectorp" "caar" "cadr" "cdar"
                "cddr" "random" "copy-tree" "make-list" "nconc" "length"))
  (let ((f (symbol-function (find-symbol (string-upcase name) '#:cl))))
    (setf (gethash (esym name) *functions*) f)))

(defprim "+" (&rest a) (apply #'+ a))
(defprim "-" (&rest a) (apply #'- a))
(defprim "*" (&rest a) (apply #'* a))
(defprim "/" (x &rest ys)
  (if (or (floatp x) (some #'floatp ys))
      (float (apply #'/ x ys) 1d0)
      (reduce (lambda (a b) (truncate a b)) ys :initial-value x)))
(defprim "%" (a b) (rem a b))
(defprim "float" (x) (float x 1d0))
(dolist (op '("=" "<" ">" "<=" ">=" "/="))
  (let ((f (symbol-function (find-symbol op '#:cl))))
    (setf (gethash (esym op) *functions*) f)))
(defprim "not" (x) (not x))
(defprim "natnump" (x) (and (integerp x) (>= x 0)))
(defprim "reverse" (s) (reverse s))
(defprim "copy-sequence" (s) (copy-seq s))
(defprim "member" (x l) (member x l :test #'equal))
(defprim "memq" (x l) (member x l :test #'eq))
(defprim "memql" (x l) (member x l :test #'eql))
(defprim "assoc" (k l &optional test) (assoc k l :test (if test (callable test) #'equal)))
(defprim "assq" (k l) (assoc k l :test #'eq))
(defprim "rassoc" (k l) (rassoc k l :test #'equal))
(defprim "rassq" (k l) (rassoc k l :test #'eq))
(defprim "alist-get" (k l &optional default remove testfn)
  (declare (ignore remove))
  (let ((cell (assoc k l :test (if testfn (callable testfn) #'eq))))
    (if cell (cdr cell) default)))
(defprim "plist-get" (plist prop &optional pred)
  (loop for (k v) on plist by #'cddr
        when (if pred (ecall pred k prop) (eq k prop)) return v))
(defprim "plist-put" (plist prop value &optional pred)
  (let ((tail (loop for rest on plist by #'cddr
                    when (if pred (ecall pred (car rest) prop) (eq (car rest) prop)) return rest)))
    (if tail (progn (setf (cadr tail) value) plist) (append plist (list prop value)))))
(defprim "plist-member" (plist prop) (loop for rest on plist by #'cddr when (eq (car rest) prop) return rest))
(defprim "delete" (x seq) (remove x seq :test #'equal))
(defprim "remove" (x seq) (remove x seq :test #'equal))
(defprim "delq" (x l) (remove x l :test #'eq))
(defprim "remq" (x l) (remove x l :test #'eq))
(defprim "delete-dups" (l) (remove-duplicates l :test #'equal :from-end t))
(defprim "number-sequence" (from &optional to (sep 1))
  (if (null to) (list from)
      (loop for i = from then (+ i sep) while (if (plusp sep) (<= i to) (>= i to)) collect i)))
(defprim "elt" (s n) (let ((x (elt s n))) (if (characterp x) (char-code x) x)))
(defprim "aref" (s n) (let ((x (aref s n))) (if (characterp x) (char-code x) x)))
(defprim "aset" (s n v) (setf (aref s n) (if (stringp s) (code-char v) v)))
(defprim "vector" (&rest a) (coerce a 'vector))
(defprim "make-vector" (n init) (make-array n :initial-element init))
(defprim "vconcat" (&rest seqs) (coerce (mapcan (lambda (s) (copy-list (elements s))) seqs) 'vector))
(defprim "sort" (seq pred)
  (let ((f (callable pred)))
    (sort (copy-seq seq) (lambda (a b) (funcall f a b)))))

(defprim "funcall" (f &rest args) (apply (callable f) args))
(defprim "apply" (f &rest args) (apply #'apply (callable f) args))
(defprim "mapcar" (f seq) (mapcar (callable f) (elements seq)))
(defprim "mapc" (f seq) (mapc (callable f) (elements seq)) seq)
(defprim "mapcan" (f seq) (mapcan (callable f) (elements seq)))
(defprim "mapconcat" (f seq &optional (sep ""))
  (format nil (concatenate 'string "~{~a~^" (remove #\~ sep) "~}")
          (mapcar (lambda (x) (princ-string (funcall (callable f) x))) (elements seq))))
(defprim "seq-filter" (f seq) (remove-if-not (callable f) (elements seq)))
(defprim "seq-remove" (f seq) (remove-if (callable f) (elements seq)))
(defprim "seq-map" (f seq) (mapcar (callable f) (elements seq)))
(defprim "seq-reduce" (f seq init) (reduce (callable f) (elements seq) :initial-value init))
(defprim "seq-find" (f seq &optional default) (or (find-if (callable f) (elements seq)) default))
(defprim "seq-some" (f seq) (some (callable f) (elements seq)))
(defprim "seq-every-p" (f seq) (every (callable f) (elements seq)))
(defprim "seq-count" (f seq) (count-if (callable f) (elements seq)))
(defprim "seq-take" (seq n) (seq-result seq (subseq (elements seq) 0 (min n (length seq)))))
(defprim "seq-drop" (seq n) (seq-result seq (nthcdr (min n (length seq)) (elements seq))))
(defprim "seq-uniq" (seq) (remove-duplicates (elements seq) :test #'equal :from-end t))
(defprim "seq-length" (seq) (length seq))
(defprim "seq-elt" (seq n) (nth n (elements seq)))
(defprim "seq-empty-p" (seq) (zerop (length seq)))
(defprim "seq-contains-p" (seq x) (member x (elements seq) :test #'equal))
(defprim "cl-remove-if" (f seq) (remove-if (callable f) (elements seq)))
(defprim "cl-remove-if-not" (f seq) (remove-if-not (callable f) (elements seq)))
(defprim "cl-find-if" (f seq) (find-if (callable f) (elements seq)))
(defprim "cl-some" (f seq) (some (callable f) (elements seq)))
(defprim "cl-every" (f seq) (every (callable f) (elements seq)))
(defprim "cl-reduce" (f seq &rest keys)
  (let ((init (getf keys (intern "initial-value" '#:keyword) :none)))
    (if (eq init :none) (reduce (callable f) (elements seq))
        (reduce (callable f) (elements seq) :initial-value init))))
(defprim "cl-position" (x seq) (position x (elements seq) :test #'equal))
(defprim "cl-first" (l) (first l))
(defprim "cl-second" (l) (second l))
(defprim "cl-subseq" (s a &optional b) (subseq s a b))

(defprim "concat" (&rest seqs)
  (apply #'concatenate 'string
         (mapcar (lambda (s) (if (stringp s) s (seq-result "" (elements s)))) seqs)))
(defprim "substring" (s &optional (start 0) end)
  (let ((n (length s)))
    (subseq s (if (minusp start) (+ n start) start)
            (cond ((null end) n) ((minusp end) (+ n end)) (t end)))))
(defprim "string" (&rest chars) (coerce (mapcar #'code-char chars) 'string))
(defprim "make-string" (n c) (make-string n :initial-element (code-char c)))
(defprim "char-to-string" (c) (string (code-char c)))
(defprim "string-to-char" (s) (if (plusp (length s)) (char-code (char s 0)) 0))
(defprim "string-to-list" (s) (map 'list #'char-code s))
(defprim "string=" (a b) (string= (princ-string a) (princ-string b)))
(defprim "string-equal" (a b) (string-equal (princ-string a) (princ-string b)))
(defprim "string<" (a b) (and (string< (princ-string a) (princ-string b)) t))
(defprim "string>" (a b) (and (string> (princ-string a) (princ-string b)) t))
(defprim "string-lessp" (a b) (and (string< (princ-string a) (princ-string b)) t))
(defprim "upcase" (x) (if (integerp x) (char-code (char-upcase (code-char x))) (string-upcase x)))
(defprim "downcase" (x) (if (integerp x) (char-code (char-downcase (code-char x))) (string-downcase x)))
(defprim "capitalize" (s) (string-capitalize s))
(defprim "string-prefix-p" (p s &optional ignore-case)
  (let ((n (length p)))
    (and (<= n (length s)) (if ignore-case (string-equal p s :end2 n) (string= p s :end2 n)))))
(defprim "string-suffix-p" (p s &optional ignore-case)
  (let ((n (length p)) (m (length s)))
    (and (<= n m) (if ignore-case (string-equal p s :start2 (- m n)) (string= p s :start2 (- m n))))))
(defprim "string-search" (needle s &optional (start 0)) (search needle s :start2 start))
(defprim "string-empty-p" (s) (zerop (length s)))
(defprim "string-blank-p" (s) (every (lambda (c) (member c '(#\Space #\Tab #\Newline #\Return))) s))
(defun ws-trim (s) (string-trim '(#\Space #\Tab #\Newline #\Return) s))
(defprim "string-trim" (s &optional left right)
  (declare (ignore left right)) (ws-trim s))
(defprim "string-trim-left" (s &optional re)
  (declare (ignore re)) (string-left-trim '(#\Space #\Tab #\Newline #\Return) s))
(defprim "string-trim-right" (s &optional re)
  (declare (ignore re)) (string-right-trim '(#\Space #\Tab #\Newline #\Return) s))
(defprim "string-join" (strings &optional (sep ""))
  (format nil (concatenate 'string "~{~a~^" (remove #\~ sep) "~}") strings))
(defprim "string-reverse" (s) (reverse s))
(defparameter +split-string-default-separators+
  (format nil "[ ~c~c~c~c~c]+" #\Page #\Tab #\Newline #\Return (code-char 11))
  "Emacs's split-string-default-separators, with the real characters.")
(defprim "split-string" (s &optional separators omit-nulls trim)
  (declare (ignore trim))
  (let ((parts (cl-ppcre:split (translate-regexp (or separators +split-string-default-separators+)) s
                               :with-registers-p nil :limit most-positive-fixnum)))
    (if (or omit-nulls (null separators)) (remove "" parts :test #'string=) parts)))
(defprim "string-to-number" (s &optional (base 10))
  (let ((s (ws-trim s)))
    (or (ignore-errors (parse-integer s :radix base :junk-allowed nil))
        (let ((*read-default-float-format* 'double-float))
          (let ((v (ignore-errors (let ((*read-eval* nil)) (read-from-string s)))))
            (if (numberp v) v 0))))))
(defprim "number-to-string" (n) (princ-string n))
(defprim "format" (control &rest args) (apply #'elisp-format control args))
(defprim "format-message" (control &rest args) (apply #'elisp-format control args))
(defprim "string-match" (re s &optional start) (string-match re s start))
(defprim "string-match-p" (re s &optional start)
  (let ((*match-data* *match-data*)) (string-match re s start)))
(defprim "match-string" (n &optional s) (match-string n s))
(defprim "match-string-no-properties" (n &optional s) (match-string n s))
(defprim "match-beginning" (n) (match-bound n :start))
(defprim "match-end" (n) (match-bound n :end))
(defprim "replace-regexp-in-string" (re rep s &rest ignore)
  (declare (ignore ignore))
  (if (stringp rep)
      (cl-ppcre:regex-replace-all (translate-regexp re) s rep)
      (cl-ppcre:regex-replace-all (translate-regexp re) s
                                  (lambda (match &rest regs) (declare (ignore regs))
                                    (funcall (callable rep) match))
                                  :simple-calls t)))
(defprim "regexp-quote" (s) (cl-ppcre:quote-meta-chars s))

(defprim "symbol-name" (s) (princ-string s))
(defprim "intern" (s) (normalize (esym s)))
(defprim "make-symbol" (s) (make-symbol s))
(defprim "symbol-value" (s) (lookup-variable s nil))
(defprim "set" (s v) (setf (gethash s *globals*) v))
(defprim "boundp" (s) (nth-value 1 (gethash s *globals*)))
(defprim "fboundp" (s) (and (or (gethash s *functions*) (gethash s *macros*)
                                (gethash (symbol-name s) *special-forms*))
                            t))
(defprim "symbol-function" (s) (gethash s *functions*))
(defprim "fset" (s f) (define-function s (callable f)) f)
(defprim "keywordp" (x) (keywordp x))
(defprim "booleanp" (x) (or (eq x t) (null x)))
(defprim "characterp" (x) (and (integerp x) (<= 0 x #x3FFFFF)))
(defprim "proper-list-p" (x) (and (listp x) (handler-case (list-length x) (error () nil))))
(defprim "type-of" (x)
  (esym (typecase x (null "symbol") (integer "integer") (float "float") (string "string")
          (cons "cons") (symbol "symbol") (vector "vector") (hash-table "hash-table")
          (function "closure") (t "unknown"))))
(defprim "eval" (form &optional lexical) (declare (ignore lexical)) (eval-form form nil))

(defprim "make-hash-table" (&rest keys)
  (let ((test (getf keys (intern "test" '#:keyword))))
    (make-hash-table :test (cond ((null test) #'eql)
                                 ((string= (symbol-name test) "equal") #'equal)
                                 ((string= (symbol-name test) "eq") #'eq)
                                 (t #'eql)))))
(defprim "gethash" (k h &optional default) (multiple-value-bind (v p) (gethash k h) (if p v default)))
(defprim "puthash" (k v h) (setf (gethash k h) v))
(defprim "remhash" (k h) (remhash k h) nil)
(defprim "clrhash" (h) (clrhash h))
(defprim "maphash" (f h) (maphash (callable f) h) nil)
(defprim "hash-table-count" (h) (hash-table-count h))
(defprim "hash-table-keys" (h) (loop for k being the hash-keys of h collect k))
(defprim "hash-table-values" (h) (loop for v being the hash-values of h collect v))
(defprim "hash-table-p" (h) (hash-table-p h))

(defprim "signal" (sym data) (error 'elisp-error :symbol sym :data data))
(defprim "error" (control &rest args) (signal-elisp "error" (apply #'elisp-format control args)))
(defprim "user-error" (control &rest args) (signal-elisp "user-error" (apply #'elisp-format control args)))
(defprim "error-message-string" (err)
  (let ((data (cdr err)))
    (if (and (member (symbol-name (car err)) '("error" "user-error") :test #'string=) (stringp (car data)))
        (car data)
        (format nil "~a: ~{~a~^, ~}" (symbol-name (car err)) (mapcar #'prin1-string data)))))
(defprim "throw" (tag value) (throw tag value))
(defprim "ignore" (&rest a) (declare (ignore a)) nil)

(defprim "message" (control &rest args)
  (let ((s (if control (apply #'elisp-format control args) nil)))
    (when s (write-line s) (finish-output))
    s))
(defprim "princ" (x &optional stream) (declare (ignore stream)) (write-string (princ-string x)) x)
(defprim "prin1" (x &optional stream) (declare (ignore stream)) (write-string (prin1-string x)) x)
(defprim "print" (x &optional stream) (declare (ignore stream)) (format t "~%~a~%" (prin1-string x)) x)
(defprim "terpri" (&optional stream) (declare (ignore stream)) (terpri) t)
(defprim "prin1-to-string" (x &optional noescape) (if noescape (princ-string x) (prin1-string x)))
(defprim "getenv" (name) (uiop:getenv name))
(defprim "current-time-string" () (multiple-value-bind (s m h d mo y) (get-decoded-time)
                                    (format nil "~d-~2,'0d-~2,'0d ~2,'0d:~2,'0d:~2,'0d" y mo d h m s)))
(defprim "file-exists-p" (f) (and (probe-file f) t))
(defprim "expand-file-name" (f &optional dir)
  (namestring (merge-pathnames (if (and (plusp (length f)) (char= (char f 0) #\~))
                                   (concatenate 'string (uiop:getenv "HOME") (subseq f 1))
                                   f)
                               (or dir (uiop:getcwd)))))
(defprim "provide" (feature &rest ignore) (declare (ignore ignore)) feature)
(defprim "require" (feature &rest ignore) (declare (ignore ignore)) feature)
(defprim "featurep" (feature &rest ignore) (declare (ignore feature ignore)) nil)

(defprim "cl-oddp" (n) (oddp n))
(defprim "cl-evenp" (n) (evenp n))
(defprim "cl-plusp" (n) (plusp n))
(defprim "cl-minusp" (n) (minusp n))
(defprim "file-name-directory" (f)
  (let ((slash (position #\/ f :from-end t))) (when slash (subseq f 0 (1+ slash)))))
(defprim "file-name-nondirectory" (f)
  (let ((slash (position #\/ f :from-end t))) (if slash (subseq f (1+ slash)) f)))
(defprim "file-name-extension" (f)
  (let* ((base (subseq f (1+ (or (position #\/ f :from-end t) -1))))
         (dot (position #\. base :from-end t)))
    (when (and dot (plusp dot)) (subseq base (1+ dot)))))
(defprim "file-name-sans-extension" (f)
  (let* ((start (1+ (or (position #\/ f :from-end t) -1)))
         (dot (position #\. f :from-end t :start start)))
    (if (and dot (> dot start)) (subseq f 0 dot) f)))
(defprim "file-name-as-directory" (f)
  (if (and (plusp (length f)) (char= (char f (1- (length f))) #\/)) f (concatenate 'string f "/")))
(defprim "directory-file-name" (f)
  (if (and (> (length f) 1) (char= (char f (1- (length f))) #\/)) (subseq f 0 (1- (length f))) f))
(defprim "file-truename" (f) (namestring (or (probe-file f) f)))
(setf (gethash (esym "load-file-name") *globals*) nil
      (gethash (esym "buffer-file-name") *globals*) nil)

;;; -- Entry points --

(defun eval-string (string)
  "Evaluate every Elisp form in STRING; return the last value."
  (let ((value nil))
    (dolist (form (read-forms string) value)
      (setf value (eval-form form nil)))))

(defun load-file (path)
  "Evaluate an .el file form by form. A top-level form that needs Emacs
(a buffer, a frame, the load path) is reported and skipped, so the file's
defuns still land. Returns the number of forms that evaluated."
  (let ((forms (read-forms (uiop:read-file-string path))) (ok 0))
    (dolist (form forms ok)
      (handler-case (progn (eval-form form nil) (incf ok))
        (error (c)
          (format *error-output* "~a: skipped ~a: ~a~%" (file-namestring path)
                  (let ((s (prin1-string (if (consp form) (list (first form) (second form)) form))))
                    (subseq s 0 (min 70 (length s))))
                  (if (typep c 'elisp-error)
                      (prin1-string (cons (error-symbol c) (error-data c)))
                      (one-line c))))))))

(defun one-line (condition)
  "CONDITION's report, whitespace collapsed to one line."
  (format nil "~{~a~^ ~}"
          (remove "" (uiop:split-string (princ-to-string condition)
                                        :separator '(#\Space #\Newline #\Tab))
                  :test #'string=)))

(defun form-complete-p (text)
  "True when TEXT holds only complete forms (a REPL entry can end)."
  (handler-case (progn (read-forms text) t)
    (end-of-file () nil)
    (error () t)))

(defun report (thunk)
  (handler-case (format t "~a~%" (prin1-string (funcall thunk)))
    (error (c) (format t "~a~%" (if (typep c 'elisp-error)
                                     (prin1-string (cons (error-symbol c) (error-data c)))
                                     (format nil "(error ~s)" (one-line c))))))
  (finish-output))

(defun repl ()
  "Read Elisp forms from standard input until EOF or (exit)."
  (format t "Elisp (native, no Emacs). Buffer/window functions are not available. (exit) or Ctrl-D to leave.~%")
  (loop
    (format t "elisp> ") (finish-output)
    (let ((text (read-line *standard-input* nil nil)))
      (unless text (terpri) (return))
      (loop until (form-complete-p text)
            do (format t "   ... ") (finish-output)
               (let ((more (read-line *standard-input* nil nil)))
                 (unless more (return))
                 (setf text (concatenate 'string text (string #\Newline) more))))
      (when (string= (ws-trim text) "(exit)") (return))
      (unless (string= (ws-trim text) "")
        (report (lambda () (eval-string text)))))))
